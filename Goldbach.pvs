%%
% @theory: Goldbach
% @author: thiago
% @date: Thu, 12 Dec 2024 18:16:15 GMT
%%
Goldbach: THEORY
  BEGIN 
    IMPORTING gcd_rem,
              ints@primes,
              %ints@div_nat,
              structures@set_as_list_props[nat]

    %List of primes less than or equal then n.
    list_of_primes(n : nat): RECURSIVE list[(prime?)] =
    IF n < 2 THEN (::)
    ELSIF prime?(n) THEN cons(n,list_of_primes(n-1))
    ELSE list_of_primes(n-1)
    ENDIF
    MEASURE n


    % @QED list_of_primes_correctness proved by thiago on Wed, 19 Feb 2025 00:20:26 GMT
    list_of_primes_correctness: LEMMA
    FORALL(n : nat, i : below[length(list_of_primes(n))]):
    prime?(nth(list_of_primes(n),i)) AND nth(list_of_primes(n),i) <= n

    list_prod(l : list[nat]) : RECURSIVE nat =
    IF null?(l) THEN 1
    ELSE car(l) * list_prod(cdr(l))
    ENDIF
    MEASURE length(l)

    % @QED list_prod_greater0 proved by thiago on Mon, 01 Dec 2025 20:34:13 GMT
    list_prod_greater0 : LEMMA
    FORALL(l : list[nat]) :
    (FORALL(i : below[length(l)]) : nth(l,i) > 0) IMPLIES list_prod(l) > 0

    nmod_pos(k : int, p : (prime?)) : nat =
    IF k >= 0 THEN nmod(k,p)
    ELSE p - nmod(-k,p)
    ENDIF

    calc_fact(n : posnat, p : (prime?) | NOT divides(p,n), k : int) : nat =
    nmod(linear_comb(n,p)`1 * nmod_pos(k,p), p)


    interval?(a,b : nat) : bool =
    a <= b


    compress_list?(n : nat)(ll : list[[nat,nat]]) : bool =
    FORALL(i : below[length(ll)-1]) :
    interval?(nth(ll,i)) AND
    nth(ll,i)`2 + 1 < nth(ll,i+1)`1 AND
    nth(ll,length(ll)-1)`2 <= n

    

    list_of_rem(n : posnat, p : (prime?) | NOT divides(p,n))
               (ll : (compress_list?(n)), i : nat) : RECURSIVE list[(interval?)] =
    IF null?(ll) THEN (::)
    ELSIF car(ll)`1 = 0 AND car(ll)`2 = n THEN  ll
    ELSIF car(ll)`1 = 0 THEN cons( (n*calc_fact(n,p,i - car(ll)`2 -1), 
                                    car(ll)`2 + 1 + n*calc_fact(n,p,i - car(ll)`2 -1)), 
                                    list_of_rem(n,p)(cdr(ll), i ))
    ELSIF car(ll)`2 = n THEN (: (car(ll)`1 - 1 + n*calc_fact(n,p,i - car(ll)`1 + 1), n) :)
    ELSE cons( (car(ll)`1 - 1 + n*calc_fact(n,p,i - car(ll)`1 + 1), 
                car(ll)`2  + n*calc_fact(n,p,i - car(ll)`1 + 1)) , 
            cons ((car(ll)`2 - car(ll)`1 + n*calc_fact(n,p,i - car(ll)`2 -1), 
                  car(ll)`2 + 1 + n*calc_fact(n,p,i - car(ll)`2 -1)),
            list_of_rem(n,p)(cdr(ll), i )))
    ENDIF
    MEASURE length(ll)

    put_list_rem(n : posnat)(ll : (compress_list?(n)), t : (interval?)) : 
          RECURSIVE (compress_list?(n)) =
    IF null?(ll) THEN (: t :)
    ELSIF t`2 + 1 < car(ll)`1 THEN cons(t,ll)
    ELSIF t`1 > car(ll)`2 + 1 THEN cons(car(ll), put_list_rem(n)(cdr(ll), t))
    ELSE cons( (min(t`1, car(ll)`1), max(t`2, car(ll)`2)), cdr(ll))
    ENDIF
    MEASURE length(ll)

    insert_rem(n : posnat)(ll1 : (compress_list?(n)), ll2 : list[(interval?)]) : 
          RECURSIVE(compress_list?(n)) =
    IF null?(ll2) THEN ll1
    ELSE insert_rem(n)(put_list_rem(n)(ll1, car(ll2)), cdr(ll2))
    ENDIF
    MEASURE length(ll2)
    
    Goldbach : CHALLENGE
    FORALL(n : nat | n >= 2):
    EXISTS(p1, p2 : (prime?)):
    2*n = p1 + p2

    
  END Goldbach
